{
  "name": "myspec-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build --mode production",
    "build:dev": "vite build --minify false --mode development",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@streamdown/code": "2.0.0",
    "@streamdown/mermaid": "1.0.3",
    "@tanstack/react-virtual": "3.14.26",
    "@wailsio/runtime": "3.1.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "diff": "9.0.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "streamdown": "2.7.1",
    "tw-animate-css": "1.4.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "30.1.3",
    "knip": "6.45.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
